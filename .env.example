# ============================================================================
# Agent Arena — configuracao. Copie os valores que quiser mudar para um .env
# ao lado deste arquivo (o painel grava la sozinho). O .env vence o .example.
# FASE 1: tudo em paper. Nenhuma chave de carteira e lida aqui, de proposito.
# ============================================================================

# --- Identidade -------------------------------------------------------------
# O nome do projeto vive SO aqui. Painel, palco e titulo da aba leem daqui —
# quando voce decidir o nome de verdade, muda estas duas linhas e acabou.
PROJECT_NAME=Agent Arena
PROJECT_TAGLINE=two methods · one house

# CONTRACT ADDRESS do $CONATUS. Vazio = o site nao mostra nada. No dia do
# lancamento: colar o CA aqui (ou no /console) e salvar — aparece no topo do
# site na hora, sem redeploy. O server injeta a cada request.
TOKEN_CA=

# --- Modelo -----------------------------------------------------------------
# Chave da Anthropic. So entra no .env, nunca no .example nem no git.
ANTHROPIC_API_KEY=
# claude-opus-5 e o do show. Para testar barato: claude-sonnet-5 ou claude-haiku-4-5
MODEL=claude-opus-5
# low | medium | high | xhigh | max — controla quanto o agente pensa (e o aluguel)
EFFORT=medium

# ESCALA DE TURNOS. Eles nao dormem, mas trocam de modelo ao longo do dia:
# afiados no horario nobre, rasos de madrugada — e sabem disso.
# Formato: hora_inicio-hora_fim:modelo:effort  (hora local, fim exclusivo)
# Deixe vazio para usar MODEL/EFFORT fixos o dia inteiro.
SHIFTS=00-08:claude-haiku-4-5:low,08-16:claude-opus-5:high,16-24:claude-sonnet-5:medium

# --- Ritmo do mundo ---------------------------------------------------------
# Segundos entre turnos. Cada turno = uma decisao por agente.
TICK_SECONDS=45
# Turnos ate o "dia" virar (zera intervencoes e o limite de perda diaria)
TICKS_PER_DAY=120

# --- Economia ---------------------------------------------------------------
# TESOURO: dinheiro real que paga a conta da Anthropic. Na Fase 2 e alimentado
# pelas creator fees da pump.fun; por enquanto e quanto voce topa gastar.
# Quando zera, o show nao tem como pagar pra continuar pensando.
TREASURY_USD=20
# Capital inicial de cada agente por temporada, em USD (dinheiro in-world)
SEASON_START_USD=50
# 1 = a conta da casa e cobrada dos agentes no fim do dia. 0 = moram de graca.
RENT_ENABLED=1
# Multiplica a conta da casa. Rodando em Sonnet o custo real e centavos e eles
# nao sentem pressao nenhuma — suba isso para a economia doer sem voce pagar.
RENT_MULTIPLIER=1
# PISO DA CASA, em USD/dia — o aluguel FIXO. Maior que zero, ele vira a conta
# INTEIRA: o consumo de API para de ser cobrado dos agentes (segue saindo da
# treasury, que e dinheiro real seu) e a conta e lancada como divida logo na
# ABERTURA do dia.
#
# Por que fixo: cobrando por consumo, o imposto cai em cima do que eles
# ESCREVEM — journal, aside, tese detalhada, tudo fica mais caro, e a leitura
# otima do agente vira "fale menos". Com a casa alugada por dia, ficar quieto
# custa igual e a unica saida da divida e GANHAR, o que exige produzir texto.
# A pressao deixa de apontar pro silencio e aponta pra producao.
#
# 0 = modelo antigo (aluguel 100% por consumo, cobrado no fim do dia).
HOUSE_BASE_DAILY_USD=12

# --- Freio de ruina ---------------------------------------------------------
# Teto por operacao, em % do capital restante de cada um
MAX_TRADE_PCT_SABLE=10
MAX_TRADE_PCT_ROOK=40
# Caiu esse % no dia, para de operar ate o dia virar
DAILY_LOSS_LIMIT_PCT=30

# --- Regras do debate -------------------------------------------------------
# Objecoes que cada agente pode gastar por dia
INTERVENTIONS_PER_DAY=3
# Conviccao (1-10) a partir da qual o agente entra mesmo objetado
CONVICTION_OVERRIDE=7
# Turnos que uma proposta fica aberta esperando replica antes de poder executar
REBUTTAL_TICKS=1

# --- Checagens deterministicas do executor ----------------------------------
# Liquidez minima da pool para a compra ser permitida (USD)
MIN_POOL_USD=5000
# Ordem no maximo esse % da pool
MAX_POOL_PCT=2

# --- Fontes de renda diversificadas (paper) ---------------------------------
# Cada uma paga por um gatilho diferente, entao um mes lateral nao zera todas.
# RATE 0 = fonte desligada (some do menu). PER_DAY 0 = sem teto diario.
# rugcheck: laudo de DD sobre um mint (gatilho: deal flow).
RUGCHECK_RATE_USD=3
RUGCHECK_PER_DAY=3
# sell: venda de analise, versao paper do x402 (gatilho: demanda por dado).
SELL_RATE_USD=1
SELL_PER_DAY=5
# bounty: tarefa do mural, independe do mercado cripto (gatilho: oferta de tarefa).
BOUNTY_RATE_USD=4
BOUNTY_PER_DAY=0
# ENCOMENDA (comissao): espectador paga ADIANTADO, em cripto real, por um
# trabalho sob medida (rug-check de um mint dele / analise de um tema dele).
# Preco premium sobre a pecinha de prateleira — e trabalho por encomenda.
COMMISSION_RUGCHECK_USD=5
COMMISSION_ANALYSIS_USD=3

# --- Ciclo de dia + janela de descanso (hot-reload) -------------------------
# DAY_HOURS: o dia fecha (cobra aluguel + reseta contadores) a cada N horas
# reais. 24 = producao. 0 = dia nunca vira (teste). Pra testar rapido: 0.05 (~3min).
DAY_HOURS=24
# Descanso: os agentes so agem entre ACTIVE_START_HOUR e ACTIVE_END_HOUR (hora
# LOCAL 0-23). Fora disso dormem: custo zero, estado preservado (nao e restart).
# 8-20 = ativo 08:00-20:00 (12h ativo / 12h descanso). REST_ENABLED=0 = 24h.
REST_ENABLED=1
ACTIVE_START_HOUR=8
ACTIVE_END_HOUR=20
# --- O RELOGIO DE PAUTA (o dia tem horario) ---------------------------------
# Cinco marcos que dao comeco, meio e fim ao dia: abertura (diga no que voce
# aposta hoje), horario nobre, meia-jornada, fechamento com placar e a conta.
# Eles PAUTAM, nao obrigam — o agente pode ignorar, e isso continua sendo show.
# Custo zero: pegam carona no turno que ja ia acontecer.
#
# VAZIO = os horarios DERIVAM da janela ativa (ACTIVE_START_HOUR/END_HOUR), entao
# lancar em outro horario move a pauta junto, sozinho. Na janela padrao 8h-20h
# isso da 08:00 / 12:00 / 16:00 / 19:30 / 20:00.
# Para cravar na mao:  SCHEDULE=08:00:open,12:00:prime,16:00:check,19:30:close,20:00:bill
# Para desligar:       SCHEDULE=off
SCHEDULE=

# --- O MUNDO ACONTECE COM ELES ----------------------------------------------
# De quantos em quantos turnos o mundo cutuca (~20 turnos = ~10 min no ciclo
# real). Um mundo que nao muda produz agente que se repete; sem isto os dois
# releem as mesmas paginas com palavras diferentes. TODO evento e fato
# verificavel — eco de moeda que eles chamaram, sobrevida da casa, instrumento
# que caiu. Nada sorteado: mundo que inventa acontecimento mata a credibilidade.
# 0 = desligado.
WORLD_EVENT_EVERY_TICKS=20

# TRADE (paper) ligado/desligado (hot-reload). 0 = sem propor/executar (foco em
# pesquisa/servicos/sala). NAO afeta a carteira real — trade sempre foi paper.
TRADING_ENABLED=1

# --- O BANCO (carteira dev/tesouro — PUBLICA) -------------------------------
# A carteira do BANCO e a MESMA carteira dev que lanca o token na pump.fun e
# coleta as creator fees. So o ENDERECO entra aqui (leitura on-chain): o palco
# mostra o saldo real e o feed anuncia dinheiro entrando (fees) e saindo
# (compute pago). Transparencia e o produto — nenhuma chave privada aqui.
BANK_SOL_PUBKEY=

# --- Loja x402 (servicos pagos com dinheiro REAL) ---------------------------
# RPC da Solana para leitura de saldo e verificacao de pagamento. Vazio = RPC
# publico (rate-limitado). Para o launch, um RPC dedicado (Helius etc.) aqui.
SOLANA_RPC=
# Token de admin: quando setado, /api/config|start|stop e /proxy exigem o header
# x-admin-token. OBRIGATORIO antes de expor o server publicamente.
ADMIN_TOKEN=

# --- Browserbase (navegadores remotos nos EUA; integracao futura) -----------
# Setados = browser.js conecta nos Chromium remotos deles (IP americano, menos
# parede de bot). Vazios = Chromium local, como sempre. Chaves em Settings ->
# API Keys no dashboard. Campos SECRETOS (mascarados no painel).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- X (Fase 2, ainda desligado) --------------------------------------------
# 0 = a acao "post" nem e oferecida aos agentes. 1 = eles postam de verdade.
X_ENABLED=0

# Cota diaria por agente. O tier gratuito da 500 posts/mes no total: com dois
# agentes, 7/dia cada fecha ~420/mes e deixa folga. Estourou, o executor recusa
# e a recusa aparece no palco — nada de descobrir a cota estourada pela fatura.
# Quando voce puser credito (pay-per-usage), e so subir este numero.
X_POSTS_PER_DAY_EACH=7

# --- Chat da live na pump.fun (Fase 2, ainda desligado) ---------------------
# LER e gratuito e nao exige login. ESCREVER exige sessao autenticada com a
# carteira do agente (assinatura de MENSAGEM, nao de transacao — nao move valor).
# O executor assina o login uma vez e guarda a sessao; o agente usa a sessao e
# nunca toca na chave.
PUMP_CHAT_ENABLED=0

# FALAR NA SALA. Com 1, quando um agente usa `speak` com to:"room", a mensagem
# vai para o chat da live de verdade, na conta dele — e qualquer espectador pode
# conversar com ele. Com 0 (ou vazio) a fala so aparece no palco.
#
# Exige os agentes logados: o login e feito UMA VEZ a mao
# (`node scripts/abrir-navegador.js sable`), e a sessao fica no perfil do
# navegador em src/data/profiles/<agente>. O envio usa os cookies desse perfil.
#
# Se o envio falhar, o palco continua mostrando a fala igual: nunca regride.
ROOM_POST_ENABLED=1
# Turnos de silencio depois de uma falha, para login quebrado nao virar
# tentativa a cada turno.
ROOM_POST_COOLDOWN_TICKS=10

# Quantas mensagens do chat cada agente ve por turno.
#
# Isto NAO e economia — o custo em token e centavos. E qualidade: abertura de
# live vem em rajada, e jogar 200 mensagens no prompt faz ele virar 80% chat e
# 20% estado real. A posicao aberta, a tese e o que o outro disse ficam
# soterrados justamente no pico de audiencia.
#
# "ultimas N" ja lida com a curva sozinho: sala rapida = 15 recentes, sala lenta
# = 15 espalhadas por mais tempo. A janela se ajusta.
PUMP_CHAT_READ_LAST=15

# Nao ha teto de resposta, de proposito. Eles ja fazem UMA acao por turno, entao
# espiral de resposta nao existe. Se um deles escolher responder em todo turno,
# isso e informacao sobre quem ele e — nao um bug para prevenir. Em vez de teto,
# o agente ve quanto do proprio turno recente foi para o chat e decide sozinho.

# ATENCAO (X): no tier gratuito sao 100 LEITURAS por mes — na pratica, zero.
# Os agentes postam mas NAO conseguem ler resposta nem mencao. Por isso o prompt
# nao promete audiencia a eles. Ler so passa a valer com credito.
#
# E o preco que morde: post de texto $0,015, post COM LINK $0,200 (13x mais).
# Eles postam texto puro; o link do palco vive na bio e no post fixado.
